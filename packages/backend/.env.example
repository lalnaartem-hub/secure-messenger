# ============================================================
# Backend environment
# Local dev: copy to packages/backend/.env and fill in.
# Production (Railway): set these as service Variables instead of a file.
# ============================================================

# --- Server ---
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed origins for CORS.
# Local: http://localhost:5173 | Prod: your public URL, e.g. https://app.up.railway.app
CORS_ORIGIN=http://localhost:5173
# Public site URL the user is sent back to after OAuth (prod = your Railway URL).
# Leave empty locally to fall back to CORS_ORIGIN.
PUBLIC_URL=

# --- Postgres ---
# Local docker: postgres://messenger:messenger@localhost:5432/messenger
# Railway: reference the Postgres plugin var, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://messenger:messenger@localhost:5432/messenger

# --- Redis ---
# Local docker: redis://localhost:6379
# Railway: reference the Redis plugin var, e.g. ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d

# --- OAuth: Google (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Prod: https://<your-domain>/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# --- OAuth: GitHub (optional) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Prod: https://<your-domain>/auth/github/callback
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback
